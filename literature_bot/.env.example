# Hepsi opsiyoneldir; anahtar olmadan da openalex/crossref/arxiv/pubmed çalışır.

# --deep-research bayrağı, draft komutu ve LLM tabanlı çeviri için: iki LLM
# sağlayıcısından SADECE BİRİNİ ayarlamanız yeterli (ikisi de ayarlıysa Claude
# önceliklidir -- NVIDIA'yı zorlamak için LLM_PROVIDER=nvidia yazın).

# Seçenek A) Claude (console.anthropic.com'dan alınır):
ANTHROPIC_API_KEY=

# Seçenek B) NVIDIA NIM / build.nvidia.com (bir model sayfasında "Get API Key" ile
# alınır, "nvapi-..." ile başlar). `pip install openai` gerekir.
NVIDIA_API_KEY=
# İsteğe bağlı: kullanılacak NVIDIA modelini değiştirmek için (varsayılan:
# mistralai/mistral-nemotron). NVIDIA'nın ücretsiz kataloğu sık değiştiği ve
# modeller zaman zaman kullanımdan kaldırıldığı için, varsayılan model
# çalışmazsa önce `python -m literature_bot.llm_probe` ile hangi modellerin
# şu an aktif olduğunu kontrol edin, sonra tam model adını buraya yazın:
# LLM_MODEL=mistralai/mistral-nemotron

# İsteğe bağlı: her ikisi de ayarlıysa hangisinin kullanılacağını zorlamak için
# ("anthropic" ya da "nvidia"):
# LLM_PROVIDER=nvidia

# İsteğe bağlı, OpenAlex "polite pool" için (daha yüksek hız limiti):
OPENALEX_EMAIL=

# İsteğe bağlı, Semantic Scholar için daha yüksek hız limiti:
SEMANTIC_SCHOLAR_API_KEY=

# İsteğe bağlı, NCBI/PubMed için daha yüksek hız limiti:
PUBMED_API_KEY=

# --fetch-fulltext ile Unpaywall'dan açık erişim PDF'lerini bulmak için önerilir
# (kendi gerçek e-postanız; Unpaywall bunu ziyade kimlik doğrulama için değil,
# iletişim/politeness amacıyla ister):
UNPAYWALL_EMAIL=kzenbil10@gmail.com

# İsteğe bağlı, DergiPark yerel önbellek veritabanının yolunu değiştirmek isterseniz:
DERGIPARK_DB=dergipark_cache.sqlite3

# --- Yalnızca webapp.py (web uygulaması) için -- CLI bunları kullanmaz ---
# Kalıcı kütüphane depolaması (Turso). Boş bırakılırsa web uygulaması yerel,
# KALICI OLMAYAN bir sqlite dosyasına düşer -- gerçek dağıtımda (bkz. DEPLOY.md)
# ikisi de mutlaka ayarlanmalı:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# İsteğe bağlı: web uygulamasının adresini bulan başkalarının kullanmasını
# engellemek için basit bir paylaşılan şifre (boşsa uygulama herkese açıktır):
APP_PASSWORD=
